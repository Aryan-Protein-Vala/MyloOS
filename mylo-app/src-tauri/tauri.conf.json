{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MYLO",
  "version": "0.1.0",
  "identifier": "com.myloos.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "MYLO : Motion. Your Live Operator.",
        "label": "main",
        "url": "/",
        "width": 1000,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      },
      {
        "title": "MYLO Overlay",
        "label": "overlay",
        "url": "/overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "fullscreen": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": ["CoreGraphics", "CoreVideo", "AppKit"],
      "infoPlist": "Info.plist"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
