{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MYLO",
  "version": "0.1.0",
  "identifier": "com.myloos.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "MYLO : Motion. Your Live Operator.",
        "label": "main",
        "url": "/",
        "width": 1000,
        "height": 800,
        "resizable": true,
        "fullscreen": false, "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      },
      {
        "title": "MYLO Overlay",
        "label": "overlay",
        "url": "/overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "fullscreen": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false, "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: blob:; connect-src 'self' https://api.openai.com https://generativelanguage.googleapis.com https://api.sarvam.ai https://api.groq.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "frameworks": ["CoreGraphics", "CoreVideo", "AppKit"],
      "infoPlist": "Info.plist"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://releases.myloos.com/update/{{target}}/{{current_version}}"
      ],
      "pubkey": "YOUR_UPDATER_PUBLIC_KEY"
    }
  }
}
